# Server-only Cloudflare R2 settings. Copy to .env.local and fill locally.
# Do not add NEXT_PUBLIC_ to credential names or commit .env.local.
# Production storage routes require an active authenticated user and scoped access.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Exact S3 endpoint shown by Cloudflare (jurisdiction-specific if applicable).
CLOUDFLARE_R2_ENDPOINT=
R2_LOCAL_PREVIEW_ENABLED=false

# Set only after the PostgreSQL database is created.
DATABASE_URL=

# Database migration / Firebase configuration (fill privately in .env.local).
MIGRATION_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Zoom Server-to-Server OAuth; server/worker only. Store secrets in Secret Manager.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Transactional class-email invitations (Resend). Server-only; use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
