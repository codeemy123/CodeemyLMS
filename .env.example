# Server-only Cloudflare R2 settings. Copy to .env.local and fill locally.
# Do not add NEXT_PUBLIC_ to credential names or commit .env.local.
# Production storage routes require an active authenticated user and scoped access.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Exact S3 endpoint shown by Cloudflare (jurisdiction-specific if applicable).
CLOUDFLARE_R2_ENDPOINT=
R2_LOCAL_PREVIEW_ENABLED=false

# PostgreSQL Database connection (configured for local server access on VPS port 5432)
DATABASE_URL=postgresql://codeemy_app:password@127.0.0.1:5432/codeemy_lms?schema=public
MIGRATION_DATABASE_URL=postgresql://postgres:admin_password@127.0.0.1:5432/codeemy_lms?schema=public

# Public URLs & Allowed Origins
NEXT_PUBLIC_APP_URL=https://lerno.codeemy.in
NEXT_PUBLIC_API_URL=https://api.lerno.codeemy.in
LMS_BACKEND_ORIGIN=https://api.lerno.codeemy.in
LMS_PUBLIC_ORIGINS=https://lerno.codeemy.in,https://learnoin.netlify.app,https://api.lerno.codeemy.in
LMS_DATABASE_MODE=true

# Firebase configuration
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Firebase Admin SDK credentials for the server only. On Windows VPS, point to
# a protected service-account JSON file outside the Git repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated server-only admin email allowlist. Do not use NEXT_PUBLIC_.
LMS_ADMIN_EMAILS=info.codeemy@gmail.com
LMS_REQUIRE_VERIFIED_ADMIN_EMAIL=true
LMS_REQUIRE_GOOGLE_ADMIN_PROVIDER=true

# Zoom Server-to-Server OAuth; server/worker only.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Transactional class-email invitations (Resend). Server-only; use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
